{
  "name": "obsidian-study-familiar",
  "version": "0.2.0",
  "description": "An Obsidian study companion that rewards the act of studying and never the rating you give yourself.",
  "main": "main.js",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
    "typecheck": "tsc -noEmit -skipLibCheck",
    "test": "npm run build && node test/smoke.mjs",
    "version": "node version-bump.mjs && git add manifest.json versions.json"
  },
  "keywords": [
    "obsidian-plugin",
    "study",
    "spaced-repetition",
    "flashcards",
    "gamification"
  ],
  "author": "Heidi Helena Anders\u00e9n",
  "license": "Apache-2.0",
  "devDependencies": {
    "@types/node": "^20.19.43",
    "esbuild": "^0.20.2",
    "obsidian": "^1.13.1",
    "tslib": "^2.6.2",
    "typescript": "^5.4.5"
  }
}
